# ===== Bot Core =====
BOT_TOKEN=123456:ABC-your-bot-token-here
BOT_USERNAME=AccessHubMarketBot
RUN_MODE=polling
# polling یا webhook

# ===== Webhook (فقط اگر RUN_MODE=webhook) =====
WEBHOOK_BASE_URL=https://your-app.onrender.com
WEBHOOK_PATH=/webhook
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/access_hub

# ===== Telegram Channels =====
MAIN_CHANNEL_ID=@AccessHubMarket
REPORT_CHANNEL_ID=@AccessHubReport

# ===== Admins =====
# لیست آیدی عددی ادمین‌های اولیه (owner) با کاما جدا شود
ADMIN_IDS=111111111,222222222

# ===== App =====
ENVIRONMENT=development
LOG_LEVEL=INFO
